{
  "name": "expo-template-blank",
  "description": "The Blank project template includes the minimum dependencies to run and an empty root component.",
  "license": "0BSD",
  "version": "57.0.20",
  "main": "index.js",
  "dependencies": {
    "expo": "~57.0.18",
    "expo-camera": "^57.0.4",
    "expo-dev-client": "^57.0.16",
    "expo-notifications": "^57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:local": "NODE_ENV=development npx dotenv -e .env.local -- expo start",
    "start:staging": "npx dotenv -e .env.staging -- expo start",
    "start:prod": "npx dotenv -e .env.production -- expo start"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
